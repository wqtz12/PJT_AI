<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stock-analysis.scheduler</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__PROJECT_DIR__/scheduler/scheduler_runner.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>__PROJECT_DIR__</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    </dict>

    <!-- 로그인 시 자동 시작 -->
    <key>RunAtLoad</key>
    <true/>

    <!-- 비정상 종료 시 재시작 (정상 종료는 재시작 안함) -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- 재시작 간격 (초) - 빠른 재시작 루프 방지 -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- 로그 파일 -->
    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/output/scheduler_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/output/scheduler_stderr.log</string>
</dict>
</plist>
